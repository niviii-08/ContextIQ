# ContextIQ — Master Environment Reference
# =========================================
# Copy this file to .env and fill in any values marked as <REQUIRED>.
# Each service also accepts its own .env file in its subdirectory.
# This root file is the single source of truth for all variables used anywhere
# in the stack.

# ===========================================================================
# SHARED DATABASE (PostgreSQL)
# ===========================================================================
# For local Docker development (default):
DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/contextiq

# For Supabase (production): replace with your connection string:
# DATABASE_URL=postgresql+psycopg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REQUIRED>
POSTGRES_DB=contextiq

# ===========================================================================
# BACKEND (Core API — port 8000)
# ===========================================================================
APP_ENV=development
APP_NAME=ContextIQ
DEBUG=false
SECRET_KEY=<REQUIRED>
API_V1_PREFIX=/api/v1

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS='["http://localhost:3000","http://localhost:8001","http://localhost:8002","http://localhost:8003","http://localhost:8004"]'

# Supabase Auth (optional — only needed when Supabase Auth is wired up)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================================================
# ML PIPELINE (ml/ directory, used by backend training commands)
# ===========================================================================
ML_MODEL_DIR=ml/models/artifacts
ML_MIN_EVENTS_FOR_TRAINING=50

# ===========================================================================
# DATA ENGINE (port 8001)
# ===========================================================================
# By default uses an embedded SQLite file — no database server required.
# To use Postgres instead, override with the DATABASE_URL above.
DATA_ENGINE_DATABASE_URL=sqlite:///./contextiq.db
CONTEXT_SWITCH_GAP_MINUTES=5
SESSION_IDLE_TIMEOUT_MINUTES=30
SYNTHETIC_RANDOM_SEED=42

# ===========================================================================
# FORGETTING ML SERVICE (port 8002)
# ===========================================================================
# No extra env vars required beyond standard Python settings.
# PYTHONPATH=/app  (set automatically by Docker)

# ===========================================================================
# CONTEXT ENGINE (port 8003)
# ===========================================================================
# No extra env vars required.
# PYTHONPATH=/srv/app  (set automatically by Docker)

# ===========================================================================
# INTELLIGENCE / LLM SERVICE (port 8004)
# ===========================================================================
# LLM provider: one of "mock" (default, no API key), "anthropic", "openai"
LLM_PROVIDER=mock

# API key for the selected LLM provider (not required for "mock")
LLM_API_KEY=<REQUIRED_WHEN_PROVIDER_IS_NOT_MOCK>

# Model name passed to the provider
LLM_MODEL=claude-sonnet-4-6

APP_VERSION=0.1.0

# ===========================================================================
# FRONTEND (Next.js — port 3000)
# ===========================================================================
# When true, all API calls use local mock data (no backend required)
NEXT_PUBLIC_USE_MOCK=false

# Base URL of the core backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional: per-service API base URLs (if services run on separate ports)
NEXT_PUBLIC_ANALYTICS_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_PREDICTION_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_CONTEXT_API_URL=http://localhost:8003/api/v1
NEXT_PUBLIC_INSIGHTS_API_URL=http://localhost:8004/api/v1

# Dev-mode "logged in as" user ID (one of the seeded demo user IDs)
NEXT_PUBLIC_DEV_USER_ID=11111111-1111-1111-1111-111111111111
