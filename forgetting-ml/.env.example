# ContextIQ Forgetting Prediction Engine — environment configuration template
# Copy to `.env` and adjust as needed. Currently the service does not
# require any secrets (fully local model artifact + no external API calls),
# but these variables are provided as hooks for deployment configuration.

# Host/port the API binds to when run via `uvicorn app.main:app`
APP_HOST=0.0.0.0
APP_PORT=8000

# Path to the trained model bundle (defaults to artifacts/model_bundle.joblib
# relative to the project root if unset)
MODEL_ARTIFACT_PATH=artifacts/model_bundle.joblib

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Number of top contributing features to return per prediction
EXPLAINABILITY_TOP_K=3
