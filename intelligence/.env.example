# LLM provider: one of "mock", "anthropic", "openai"
# "mock" requires no API key and is used for tests / offline runs.
LLM_PROVIDER=mock

# API key for the selected provider (not required for "mock").
LLM_API_KEY=

# Model name passed to the provider.
LLM_MODEL=claude-sonnet-4-6

APP_VERSION=0.1.0
