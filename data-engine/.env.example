# ContextIQ Data Engine - environment configuration
# ---------------------------------------------------
# Leave DATABASE_URL unset (or use the sqlite default) for local development.
# For Supabase / production Postgres, set DATABASE_URL to your connection string, e.g.:
# DATABASE_URL=postgresql+psycopg2://postgres:password@db.your-project.supabase.co:5432/postgres

DATABASE_URL=sqlite:///./contextiq.db

# Application
APP_ENV=development
APP_NAME=ContextIQ Data Engine
API_V1_PREFIX=/api/v1

# Session engine tuning
CONTEXT_SWITCH_GAP_MINUTES=5
SESSION_IDLE_TIMEOUT_MINUTES=30

# Synthetic data generation
SYNTHETIC_RANDOM_SEED=42
